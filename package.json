{
  "name": "tile-render-server",
  "version": "0.0.0",
  "description": "On-demand SVG tile API backed by PMTiles",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "fsarch-server start",
    "render": "node dist/cli/index.js",
    "example": "node dist/example/example-server.js --port 4173 --api-base http://127.0.0.1:3000",
    "test": "npm run build && vitest run",
    "migration:create": "typeorm-ts-node-esm ./node_modules/typeorm/cli.js migration:create ./src/database/migrations/$npm_config_name",
    "migration:run": "typeorm-ts-node-esm -d src/database/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-esm -d src/database/data-source.ts migration:revert"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@fsarch/server": "^0.1.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.3",
    "js-yaml": "^5.2.3",
    "minimist": "^1.2.8",
    "pbf": "^5.1.2",
    "pg": "^8.22.0",
    "pmtiles": "^4.4.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
