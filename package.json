{
  "name": "tile-render-server",
  "version": "0.0.6",
  "description": "On-demand SVG tile API backed by PMTiles",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "fsarch-server start",
    "render": "node dist/cli/index.js",
    "example": "node dist/example/example-server.js --port 4173 --api-base http://127.0.0.1:3000",
    "test": "pnpm run build && vitest run",
    "format": "biome format --write src",
    "lint": "biome check --write src",
    "migration:create": "typeorm-ts-node-esm ./node_modules/typeorm/cli.js migration:create ./src/database/migrations/$npm_config_name",
    "migration:run": "typeorm-ts-node-esm -d src/database/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-esm -d src/database/data-source.ts migration:revert"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@fsarch/server": "^0.3.3",
    "@opentelemetry/api": "^1.9.1",
    "@mapbox/vector-tile": "^3.0.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.1",
    "js-yaml": "^5.4.2",
    "minimist": "^1.2.8",
    "pbf": "^5.1.2",
    "pg": "^8.23.0",
    "pmtiles": "^4.5.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
